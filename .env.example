# Variables de entorno de la Content Factory.
#
# Copiá este archivo a .env para desarrollo local (netlify dev lo lee) y cargá
# los mismos valores en el panel de Netlify para producción.
# .env está en .gitignore: ningún secreto entra al repositorio.

# ─── Sesión ────────────────────────────────────────────────────────────────
# Firma las cookies de sesión y se comparte entre las funciones y el edge.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Usuarios habilitados, como array JSON de { email, salt, hash }.
# Generá cada entrada con:  npm run hash-password -- tu@email.com "tu contraseña"
# Nunca hay contraseñas en texto plano acá ni en el JavaScript del cliente.
FACTORY_USERS=[]

# ─── OpenAI ────────────────────────────────────────────────────────────────
# Sólo del lado del servidor. El frontend nunca la ve.
OPENAI_API_KEY=

# Modelos. Los defaults están en el código; se sobreescriben acá sin tocar nada.
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Worker de procesamiento y render ──────────────────────────────────────
# URL pública del worker (Railway, Fly, Render, un VPS). Sin barra final.
WORKER_URL=

# Secreto compartido con el worker: firma los tickets con los que el navegador
# sube archivos y pide renders. Distinto de SESSION_SECRET, a propósito: si se
# filtra uno, el otro sigue sirviendo.
WORKER_SECRET=
